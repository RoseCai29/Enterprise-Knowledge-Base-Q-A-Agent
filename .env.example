# ================= Agent / LLM =================
# OpenAI 兼容 Chat API（DeepSeek / SiliconFlow / OpenAI / 其他）
# 注意：DeepSeek 无 embedding 接口 —— 检索向量请用本地 local 模式（见下）。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ================= Embeddings =================
# EMBED_MODE: local | api | debug
#   local -> 本地 sentence-transformers（bge 中文），无需外网 embedding key，生产推荐。
#   api   -> 用 EMBED_BASE_URL 提供 embedding 接口（如 SiliconFlow 的 bge-large-zh）
#   debug -> 确定性 hash 向量占位，仅 demo/测试。
EMBED_MODE=local
EMBED_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
EMBED_LOCAL_CACHE=./.cache/models
EMBED_LOCAL_DEVICE=cpu          # cpu | cuda
# HuggingFace 镜像端点（直连 huggingface.co 不通时用 hf-mirror.com）
EMBED_HF_ENDPOINT=https://hf-mirror.com
# api 模式专用：
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-large-zh-v1.5
EMBED_DIM=1024

# ================= Service / Auth =================
# 配置后 /api/**（ask/retrieve/ingest）要求请求头 X-API-Key 一致；为空则放行（便于本地调试）。
API_KEY=
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# ================= Storage =================
# runtime 数据落盘目录（sqlite + faiss + bm25）
DATA_DIR=./data

# ================= Retrieval =================
TOP_K=8                 # 混合检索返回的最终结果数
VECTOR_TOP_K=20         # 向量检索召回数（融合前）
BM25_TOP_K=20           # BM25 召回数（融合前）
RRF_K=60                # RRF 融合常数 k
RETRIEVAL_TOTAL_LIMIT=30

# ================= Chunking =================
CHUNK_SIZE=1000
CHUNK_OVERLAP=120

# ================= Agent =================
MAX_AGENT_STEPS=4
MAX_REFLECTION=2